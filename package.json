{
  "name": "html-snippets",
  "displayName": "HTML/CSS/JavaScript Snippets",
  "description": "HTML/CSS/JavaScript/Jade/Pug/Less/Sass/Stylus/ES6 Snippets Support",
  "version": "1.0.6",
  "publisher": "wscats",
  "icon": "images/logo.png",
  "engines": {
    "vscode": "^1.40.0",
    "node": ">=18.0.0"
  },
  "keywords": [
    "html",
    "html5",
    "css",
    "css3",
    "javascript",
    "typescript",
    "ES6",
    "ES7",
    "snippets"
  ],
  "author": {
    "name": "Eno Yao",
    "email": "kalone.cool@gmail.com",
    "url": "https://github.com/Wscats"
  },
  "galleryBanner": {
    "color": "#58bc58",
    "theme": "light"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "scripts": {
    "build": "vsce package",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "test": "jest --coverage",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint . --ext .ts,.tsx,.js,.jsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "contributes": {
    "snippets": [
      {
        "language": "html",
        "path": "./snippets/html.json"
      },
      {
        "language": "jade",
        "path": "./snippets/html.json"
      },
      {
        "language": "pug",
        "path": "./snippets/html.json"
      },
      {
        "language": "css",
        "path": "./snippets/css.json"
      },
      {
        "language": "scss",
        "path": "./snippets/css.json"
      },
      {
        "language": "sass",
        "path": "./snippets/css.json"
      },
      {
        "language": "less",
        "path": "./snippets/css.json"
      },
      {
        "language": "stylus",
        "path": "./snippets/css.json"
      },
      {
        "language": "javascript",
        "path": "./snippets/javascript.json"
      },
      {
        "language": "typescript",
        "path": "./snippets/javascript.json"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wscats/html-snippets.git"
  },
  "bugs": {
    "url": "https://github.com/wscats/html-snippets/issues"
  },
  "homepage": "https://github.com/wscats/html-snippets#readme"
}
